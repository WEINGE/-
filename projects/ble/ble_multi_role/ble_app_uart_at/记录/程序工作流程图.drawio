        <mxCell id="t1_step7" value="水浸检测逻辑&#xa;(压差→水深→阈值比较)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1">

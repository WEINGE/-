        <mxCell id="t1_step1" value="上电传感器&#xa;(S_EN, P_M_EN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">

        <mxCell id="t2_step2" value="打开UART1并等待&#xa;(10秒DTU就绪)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">

        <mxCell id="t1_step6" value="获取RTC时间戳" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">

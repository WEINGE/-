        <mxCell id="t2_step6" value="发送105-监测数据&#xa;(批量发送缓冲区数据)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">

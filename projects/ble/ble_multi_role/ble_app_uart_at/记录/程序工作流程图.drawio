        </mxCell>

        <mxCell id="t2_step4" value="发送103-状态信息" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">

        <mxCell id="t2_step7" value="等待发送完成 (5秒)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1">

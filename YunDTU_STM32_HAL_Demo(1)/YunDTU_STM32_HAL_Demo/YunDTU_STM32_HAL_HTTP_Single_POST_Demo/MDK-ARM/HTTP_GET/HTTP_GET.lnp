--cpu Cortex-M3
"http_get\startup_stm32f103xe.o"
"http_get\main.o"
"http_get\gpio.o"
"http_get\tim.o"
"http_get\usart.o"
"http_get\stm32f1xx_it.o"
"http_get\stm32f1xx_hal_msp.o"
"http_get\stm32f1xx_hal_gpio_ex.o"
"http_get\stm32f1xx_hal_tim.o"
"http_get\stm32f1xx_hal_tim_ex.o"
"http_get\stm32f1xx_hal.o"
"http_get\stm32f1xx_hal_rcc.o"
"http_get\stm32f1xx_hal_rcc_ex.o"
"http_get\stm32f1xx_hal_gpio.o"
"http_get\stm32f1xx_hal_dma.o"
"http_get\stm32f1xx_hal_cortex.o"
"http_get\stm32f1xx_hal_pwr.o"
